<Page x:Class="Into_the_depths.CharacterCreation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:Into_the_depths"
      mc:Ignorable="d" 
      d:DesignHeight="495" d:DesignWidth="880"
      Title="CharacterCreation">

    <Grid Background="#FF9BB4C1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel>
            
       
        <StackPanel Height="auto" Width="auto" Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
            <TextBlock FontSize="14">Name:</TextBlock>
            <TextBox Name="CharName" Width="100" Margin="10,0,0,0" FontSize="14"></TextBox>
        </StackPanel>
        <ComboBox Grid.Column="0">
            <ComboBoxItem>Paladin</ComboBoxItem>
            <ComboBoxItem>Warrior</ComboBoxItem>
            <ComboBoxItem>Rogue</ComboBoxItem>
            <ComboBoxItem>Ranger</ComboBoxItem>
            <ComboBoxItem>Mage</ComboBoxItem>
            <ComboBoxItem>Priest</ComboBoxItem>
        </ComboBox>
        <ItemsControl ItemsSource="{Binding StatDictionary}" Grid.Column="0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Key}" Margin="0,0,10,0"></TextBlock>
                        <Button Grid.Column="1" Content="+" Margin="0,0,10,0" Width="20" Height="20"
                                Command="{Binding DataContext.ChangeStat, RelativeSource={RelativeSource AncestorType=Page}}">
                            <Button.CommandParameter>
                                <x:Array Type="{x:Type System:String}">
                                    <System:String>{Binding Key}</System:String>
                                    <System:String>true</System:String>
                                </x:Array>
                            </Button.CommandParameter>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding Value}" Margin="0,0,10,0"></TextBlock>
                        <Button Grid.Column="3" Content="-" Margin="0,0,10,0" Width="20" Height="20"
                                Command="{Binding DataContext.ChangeStat, RelativeSource={RelativeSource AncestorType=Page}}">
                            <Button.CommandParameter>
                                <x:Array Type="{x:Type System:String}">
                                    <System:String>{Binding Key}</System:String>
                                    <System:String>false</System:String>
                                </x:Array>
                            </Button.CommandParameter>
                        </Button> 

                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock ><Run Text="Unassigned points:"/></TextBlock>
                <TextBlock Name="unassignedText" Margin="5,0,0,0" Text="{Binding UnassignedPoints}"></TextBlock>
            </StackPanel>
        </StackPanel>
