<Page x:Class="Into_the_depths.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Into_the_depths"
      mc:Ignorable="d" 
      d:DesignHeight="495" d:DesignWidth="880"
      Title="StartPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="#FFC0D0DC" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="/Fonts/#Cinzel"></Setter>
                <Setter Property="FontSize" Value="24"></Setter>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontWeight" Value="SemiBold"></Setter>
                <Setter Property="Padding" Value="10"></Setter>
                <Setter Property="Margin" Value="4"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="30"></Setter>
                    </Style>
                </Style.Resources>
            </Style>
        </Grid.Resources>
            <UniformGrid Columns="2"
                    HorizontalAlignment="Center"
                    Width="600"
                    Height="150">
            <Button 
                Foreground="#2B2A5E" 
                BorderBrush="#4A4888" >
                <Button.Content>
                    <Viewbox Stretch="Uniform">
                        
                    <TextBlock>New Game</TextBlock>
                    </Viewbox>
                </Button.Content>
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E8ECF6" Offset="0"/>
                        <GradientStop Color="#B4C3E2" Offset="0.5"/>
                        <GradientStop Color="#55559A" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                
            </Button>
            <Button 
                Foreground="#4A1A05" 
                BorderBrush="#8A2E0A"
                >
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FBC531" Offset="0"/>
                        <GradientStop Color="#F08A2E" Offset="0.45"/>
                        <GradientStop Color="#9A2E0C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Content>
                    <Viewbox Stretch="Uniform">
                        
                    <TextBlock>Load Game</TextBlock>
                    </Viewbox>
                </Button.Content>
            </Button>
        </UniformGrid>



    </Grid>
</Page>
