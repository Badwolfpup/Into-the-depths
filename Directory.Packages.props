<Project>
  <!-- Central Package Management: every NuGet version is set here; project files reference packages without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers run in every project at build time and are never shipped. -->
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.290" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

  <ItemGroup>
    <!-- App -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />

    <!-- Tests -->
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
